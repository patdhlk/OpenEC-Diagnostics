<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Passive EtherCAT monitoring SDK: EtherCAT frame decoding, pcap/pcapng reading, ENI/ESI parsing, and ENI-independent bus learning for .NET.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dahlke.EtherCAT.Cia402" Version="0.10.0" />
    <PackageReference Include="Dahlke.EtherCAT.Esi" Version="0.10.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenEC.Monitor.Tests" />
  </ItemGroup>

</Project>
