<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenEC.Inspector.Views.AboutWindow"
        Title="About OpenEC Inspector"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Width="440"
        ShowInTaskbar="False">
    <StackPanel Margin="28" Spacing="10">
        <TextBlock Text="OpenEC Inspector"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Accent}" />
        <TextBlock x:Name="VersionText"
                   Foreground="{DynamicResource Ink2}" />
        <TextBlock Foreground="{DynamicResource Ink}"
                   TextWrapping="Wrap"
                   Text="Passive EtherCAT monitoring and diagnostics. Observes and never transmits — safe to attach to a running machine." />
        <TextBlock Foreground="{DynamicResource Ink2}"
                   Text="https://github.com/patdhlk/OpenEC-Diagnostics" />
        <TextBlock Foreground="{DynamicResource Ink2}"
                   FontSize="12"
                   Text="Copyright (c) 2026 Patrick Dahlke · Apache-2.0" />
        <Button Content="Close"
                HorizontalAlignment="Right"
                Click="OnClose" />
    </StackPanel>
</Window>
